/* Tablas */

create table bank.cat_imagenes(
							cod_imagen  smallint,
							desc_imagen char(100),
							ind_activo  smallint,
							fyh_carga   timestamp,
							fyh_modificacion timestamp
						 );

create table bank.cat_tipos_oferta
									(cod_tipo_oferta smallint,
									desc_tipo_oferta char(30),
									num_orden 		 smallint,
									ind_activo 		 smallint,
									fyh_carga 		 timestamp,
									fyh_modificacion timestamp);


create table bank.mst_beneficios_nomina
										(cod_cliente 	 integer,
