-- Realiza consultas que utilicen la cláusula PARTITION BY para hacer cálculos agrupados por algún campo y explica brevemente qué hace cada consulta

SELECT venta_id
        ,fecha_venta
        ,articulo
        ,talla
        ,precio
        ,cantidad
        ,vendedor
        ,SUM(cantidad) OVER (PARTITION BY articulo) AS total_por_articulo   -- Suma de cantidad por articulo
FROM ventas_articulos;

select articulo
        ,talla
        ,cantidad
        ,SUM(cantidad) OVER (Partition by talla) as tot_talla
from ventas_articulos;                  -- Cantidad por taa


