 FROM VENTAS_ARTICULOS
 group by talla;

 SELECT MAX(cantidad)
        ,vendedor
    FROM VENTAS_ARTICULOS
    group by vendedor;

SELECT SUM(CANTIDAD)
 FROM ventas_articulos;

 SELECT AVG(cantidad)
 from ventas_articulos;

 SELECT COUNT(1) from ventas_articulos;

SELECT
    fecha_venta,
    articulo,
    talla,
    precio,
    cantidad,
    precio * cantidad AS venta_del_dia,
    SUM(precio * cantidad) OVER (
        ORDER BY fecha_venta
        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ) AS ventas_acumuladas
FROM ventas_articulos
ORDER BY fecha_venta;
