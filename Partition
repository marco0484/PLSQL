-- Crea una tabla que permita hacer operaciones matemáticas (sum, resta, etc) con sus campos

CREATE TABLE ventas_articulos (
    venta_id      NUMBER,
    fecha_venta   DATE,
    articulo      VARCHAR2(50),
    talla         VARCHAR2(5),
    precio        NUMBER(8,2),
    cantidad      NUMBER,
    vendedor      VARCHAR2(30)
);

